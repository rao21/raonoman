---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import DevBar from '../components/DevBar.astro';
import Footer from '../components/Footer.astro';
import Boot from '../components/Boot.astro';
import Hero from '../components/Hero.astro';
import Problems from '../components/Problems.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Process from '../components/Process.astro';
import Why from '../components/Why.astro';
---

<Base>
  <Boot />
  <Nav />
  <main id="main">
    <Hero />
    <Problems />
    <Services />
    <Work />
    <Process />
    <Why />
  </main>
  <Footer />
  <DevBar />
  <script>import '../scripts/reveal';</script>
  <script>import '../scripts/spotlight';</script>
