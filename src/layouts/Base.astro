---
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource/instrument-serif';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { site } from '../content/site';
import { withBase } from '../lib/base';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  jsonLd?: object[];
  /** Keep the page out of search indexes (and skip canonical/og:url), e.g. the 404. */
  noindex?: boolean;
}

const { title = site.title, description = site.description, path = '/', jsonLd = [], noindex = false } = Astro.props;
const canonical = new URL(withBase(path), Astro.site).href;
const og = new URL(withBase('/og.png'), Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:type" content="website" /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} />{!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={og} /><meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      try { var s = localStorage.getItem('skin'); if (s === 'paper' || s === 'graphite' || s === 'flutter') document.documentElement.setAttribute('data-skin', s); } catch (e) {}
    </script>
    {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
